# Required for LiteLLM Bedrock calls
AWS_REGION=us-west-2
AWS_REGION_NAME=us-west-2
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# MLflow uses a local ./mlruns directory when this is omitted.
# For a shared tracking server, set for example:
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=finalex

# Local or deployed resource names
AURORA_DATABASE=finalex
TAGGER_FUNCTION=finalex-tagger
REPORTER_FUNCTION=finalex-reporter
CHARTER_FUNCTION=finalex-charter
RETIREMENT_FUNCTION=finalex-retirement
SQS_QUEUE_NAME=finalex-analysis-jobs
